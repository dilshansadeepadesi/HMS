# ==============================================================================
# MediPlus - Secure Hospital Management System for Sri Lanka
# Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# Copy this file to '.env' and supply your actual configuration values.
# NEVER commit your production '.env' file or production credentials to Git!
# ==============================================================================

# Server & Runtime Configuration
NODE_ENV=development
PORT=5000

# PostgreSQL Database Connection
# Supported by Neon, Supabase, AWS RDS, Azure Database for PostgreSQL, or local PostgreSQL.
# In serverless/Vercel deployments, use a pooled connection string with connection_limit.
# Example: postgres://username:password@ep-xyz.ap-southeast-1.aws.neon.tech/mediplus?sslmode=require&pgbouncer=true
DATABASE_URL="postgresql://postgres:your_secure_password@localhost:5432/mediplus_db?schema=public"

# Authentication & Session Security
# Generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-very-long-and-secure-random-secret-key-min-32-chars"
SESSION_EXPIRY="8h"
COOKIE_DOMAIN=""
COOKIE_SECURE="false" # Set to "true" in production (HTTPS)

# Rate Limiting & Security
RATE_LIMIT_WINDOW_MS=900000 # 15 minutes
RATE_LIMIT_MAX_ATTEMPTS=10

# Sri Lankan Localization Defaults
DEFAULT_LOCALE="en-LK"
DEFAULT_TIMEZONE="Asia/Colombo"
DEFAULT_CURRENCY="LKR"

# Hospital Branding & General Info
HOSPITAL_NAME="MediPlus Hospital & Healthcare Center"
HOSPITAL_REG_NO="PV-LK-2026/0491"
HOSPITAL_ADDRESS="124/B Galle Road, Colombo 03, Sri Lanka"
HOSPITAL_PHONE="+94 11 234 5678"
HOSPITAL_EMAIL="care@mediplus.lk"

# Demo Account Credentials (Used ONLY by seed script in non-production environments)
# During seed execution, these credentials are used to generate hashed demo accounts.
DEMO_ADMIN_USERNAME="admin"
DEMO_ADMIN_PASSWORD="DemoAdminPassword123!"
