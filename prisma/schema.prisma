generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  LAB_STAFF
  PHARMACIST
  ACCOUNTANT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  ARRIVED
  IN_CONSULTATION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  OPD
  CONSULTATION
  FOLLOW_UP
  EMERGENCY
}

enum PrescriptionStatus {
  PENDING
  DISPENSED
  PARTIAL
  CANCELLED
}

enum LabRequestStatus {
  REQUESTED
  SAMPLE_COLLECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum Priority {
  ROUTINE
  URGENT
  STAT
}

enum StockMovementType {
  PURCHASE
  DISPENSE
  ADJUSTMENT
  RETURN
  EXPIRED_DISPOSAL
}

enum WardType {
  MALE
  FEMALE
  PEDIATRIC
  SURGICAL
  MATERNITY
  ICU
  ETU
  PCU
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum AdmissionStatus {
  ADMITTED
  DISCHARGED
  TRANSFERRED
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum ItemType {
  CONSULTATION
  LAB_TEST
  PHARMACY
  WARD_CHARGE
  PROCEDURE
  OTHER
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  INSURANCE
  ONLINE
}

enum EmploymentType {
  PERMANENT
  CONTRACT
  VISITING
  INTERN
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  ON_LEAVE
}

enum LeaveType {
  ANNUAL
  CASUAL
  MEDICAL
  DUTY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------
// Authentication & User Management
// ---------------------------------------------------------
model User {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String    @unique
  passwordHash String
  fullName     String
  role         Role
  phone        String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  doctorProfile   Doctor?
  employeeProfile Employee?
  auditLogs       AuditLog[]

  @@index([username])
  @@index([email])
  @@index([role])
}

// ---------------------------------------------------------
// Departments & Doctors
// ---------------------------------------------------------
model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  doctors      Doctor[]
  employees    Employee[]
  appointments Appointment[]
}

model Doctor {
  id                 String     @id @default(uuid())
  userId             String     @unique
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  slmcRegNo          String     @unique // Sri Lanka Medical Council Registration Number
  specialization     String
  qualification      String
  consultationFee    Decimal    @default(1500.00) @db.Decimal(10, 2)
  departmentId       String
  department         Department @relation(fields: [departmentId], references: [id])
  roomNumber         String?
  availableDays      String     @default("Monday,Tuesday,Wednesday,Thursday,Friday") // Comma-separated
  morningSlotStart   String?    @default("08:30")
  morningSlotEnd     String?    @default("12:30")
  eveningSlotStart   String?    @default("16:00")
  eveningSlotEnd     String?    @default("20:00")
  maxPatientsPerSlot Int        @default(20)
  isActive           Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  prescriptions  Prescription[]
  labRequests    LaboratoryRequest[]
  admissions     Admission[]

  @@index([departmentId])
  @@index([slmcRegNo])
  @@index([specialization])
}

// ---------------------------------------------------------
// Patient Management
// ---------------------------------------------------------
model Patient {
  id                       String   @id @default(uuid())
  patientId                String   @unique // e.g., MP-2026-0001
  fullName                 String
  nic                      String? // Sri Lankan NIC (9 digits + V/X or 12 digits)
  passport                 String? // Foreign patient Passport number
  dateOfBirth              DateTime
  gender                   Gender
  bloodGroup               String? // A+, A-, B+, B-, AB+, AB-, O+, O-
  phone                    String // e.g. +94 77 123 4567 or 0771234567
  email                    String?
  address                  String
  province                 String // Western, Central, Southern, etc.
  district                 String // Colombo, Kandy, Galle, etc.
  postalCode               String?
  emergencyContactName     String
  emergencyContactPhone    String
  emergencyContactRelation String
  allergies                String?
  medicalAlerts            String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  prescriptions  Prescription[]
  labRequests    LaboratoryRequest[]
  admissions     Admission[]
  invoices       Invoice[]
  documents      PatientDocument[]

  @@index([patientId])
  @@index([nic])
  @@index([phone])
  @@index([fullName])
}

// ---------------------------------------------------------
// Appointments
// ---------------------------------------------------------
model Appointment {
  id                 String            @id @default(uuid())
  appointmentNumber  String            @unique // e.g. APT-2026-0001
  patientId          String
  patient            Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId           String
  doctor             Doctor            @relation(fields: [doctorId], references: [id])
  departmentId       String
  department         Department        @relation(fields: [departmentId], references: [id])
  appointmentDate    DateTime          @db.Date
  slotTime           String // e.g. "09:00 AM"
  queueNumber        Int
  type               AppointmentType   @default(CONSULTATION)
  status             AppointmentStatus @default(SCHEDULED)
  cancellationReason String?
  bookedByUserId     String?
  notes              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  medicalRecord MedicalRecord?

  @@unique([doctorId, appointmentDate, slotTime, queueNumber])
  @@index([appointmentDate, doctorId])
  @@index([patientId])
  @@index([status])
}

// ---------------------------------------------------------
// Electronic Medical Records (EMR)
// ---------------------------------------------------------
model MedicalRecord {
  id               String       @id @default(uuid())
  patientId        String
  patient          Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId         String
  doctor           Doctor       @relation(fields: [doctorId], references: [id])
  appointmentId    String?      @unique
  appointment      Appointment? @relation(fields: [appointmentId], references: [id])
  visitDate        DateTime     @default(now())
  chiefComplaint   String
  examinationNotes String?
  diagnosis        String
  icdCode          String?
  treatmentPlan    String?
  // Vitals
  vitalsSystolic   Int?
  vitalsDiastolic  Int?
  vitalsPulse      Int?
  vitalsTemp       Decimal?     @db.Decimal(4, 1) // Celsius e.g. 37.2
  vitalsSpo2       Int? // % e.g. 98
  vitalsWeightKg   Decimal?     @db.Decimal(5, 2)
  followUpDate     DateTime?    @db.Date
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  prescriptions Prescription[]

  @@index([patientId])
  @@index([doctorId])
  @@index([visitDate])
}

// ---------------------------------------------------------
// Prescriptions & Pharmacy
// ---------------------------------------------------------
model Prescription {
  id                String             @id @default(uuid())
  prescriptionNo    String             @unique // RX-2026-0001
  medicalRecordId   String?
  medicalRecord     MedicalRecord?     @relation(fields: [medicalRecordId], references: [id])
  patientId         String
  patient           Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId          String
  doctor            Doctor             @relation(fields: [doctorId], references: [id])
  status            PrescriptionStatus @default(PENDING)
  notes             String?
  dispensedByUserId String?
  dispensedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  items PrescriptionItem[]

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
}

model PrescriptionItem {
  id                 String       @id @default(uuid())
  prescriptionId     String
  prescription       Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineId         String
  medicine           Medicine     @relation(fields: [medicineId], references: [id])
  dosage             String // e.g. "500mg"
  frequency          String // e.g. "TDS (Three times daily) - After meals"
  durationDays       Int // e.g. 5
  instructions       String?
  quantityPrescribed Int
  quantityDispensed  Int          @default(0)

  @@index([prescriptionId])
  @@index([medicineId])
}

model Medicine {
  id           String   @id @default(uuid())
  code         String   @unique // e.g. MED-001
  brandName    String
  genericName  String
  category     String // e.g. Antibiotic, Analgesic, Antihypertensive
  dosageForm   String // Tablet, Capsule, Syrup, Injection, Ointment, etc.
  strength     String // e.g. 500mg, 10ml, 50mg/5ml
  unit         String   @default("tablets") // tablets, bottles, vials, tubes
  unitPrice    Decimal  @db.Decimal(10, 2) // LKR
  reorderLevel Int      @default(50)
  currentStock Int      @default(0)
  manufacturer String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  batches           MedicineBatch[]
  stockMovements    StockMovement[]
  prescriptionItems PrescriptionItem[]

  @@index([code])
  @@index([genericName])
  @@index([brandName])
  @@index([category])
}

model MedicineBatch {
  id                String   @id @default(uuid())
  medicineId        String
  medicine          Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batchNumber       String // e.g. BATCH-2026-X1
  manufacturingDate DateTime @db.Date
  expiryDate        DateTime @db.Date
  purchaseQuantity  Int
  currentQuantity   Int
  purchasePrice     Decimal  @db.Decimal(10, 2) // LKR
  sellingPrice      Decimal  @db.Decimal(10, 2) // LKR
  supplier          String?
  isQuarantined     Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  stockMovements StockMovement[]

  @@index([medicineId])
  @@index([expiryDate])
  @@index([batchNumber])
}

model StockMovement {
  id                String            @id @default(uuid())
  medicineId        String
  medicine          Medicine          @relation(fields: [medicineId], references: [id])
  batchId           String?
  batch             MedicineBatch?    @relation(fields: [batchId], references: [id])
  movementType      StockMovementType
  quantity          Int
  previousStock     Int
  newStock          Int
  referenceId       String? // e.g. Invoice ID, Prescription ID, PO Number
  notes             String?
  performedByUserId String
  createdAt         DateTime          @default(now())

  @@index([medicineId])
  @@index([movementType])
  @@index([createdAt])
}

// ---------------------------------------------------------
// Laboratory Management
// ---------------------------------------------------------
model LaboratoryTest {
  id                  String   @id @default(uuid())
  code                String   @unique // e.g. LAB-FBC
  name                String // e.g. Full Blood Count (FBC)
  category            String // Hematology, Biochemistry, Microbiology, Serology
  description         String?
  price               Decimal  @db.Decimal(10, 2) // LKR
  turnaroundHours     Int      @default(4)
  referenceRangesJson String? // JSON string representing normal parameters & units
  sampleType          String // Whole Blood (EDTA), Serum, Urine, etc.
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  results LaboratoryResult[]

  @@index([code])
  @@index([category])
}

model LaboratoryRequest {
  id                      String           @id @default(uuid())
  requestNumber           String           @unique // LR-2026-0001
  patientId               String
  patient                 Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId                String
  doctor                  Doctor           @relation(fields: [doctorId], references: [id])
  status                  LabRequestStatus @default(REQUESTED)
  priority                Priority         @default(ROUTINE)
  sampleCollectedAt       DateTime?
  sampleCollectedByUserId String?
  clinicalHistory         String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  results LaboratoryResult[]

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
}

model LaboratoryResult {
  id                  String            @id @default(uuid())
  laboratoryRequestId String
  laboratoryRequest   LaboratoryRequest @relation(fields: [laboratoryRequestId], references: [id], onDelete: Cascade)
  laboratoryTestId    String
  laboratoryTest      LaboratoryTest    @relation(fields: [laboratoryTestId], references: [id])
  resultValuesJson    String? // JSON string with tested parameters, values, and flags
  status              String            @default("PENDING") // PENDING, COMPLETED, VERIFIED
  verifiedByUserId    String?
  verifiedAt          DateTime?
  notes               String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([laboratoryRequestId])
  @@index([laboratoryTestId])
}

// ---------------------------------------------------------
// Inpatient & Outpatient Management (Wards & Beds)
// ---------------------------------------------------------
model Ward {
  id          String   @id @default(uuid())
  name        String   @unique // e.g. Male Medical Ward, Pediatric Ward
  code        String   @unique // e.g. WARD-MM1
  wardType    WardType
  totalBeds   Int      @default(20)
  dailyRate   Decimal  @db.Decimal(10, 2) // LKR per day
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  beds       Bed[]
  admissions Admission[]
}

model Bed {
  id        String    @id @default(uuid())
  wardId    String
  ward      Ward      @relation(fields: [wardId], references: [id], onDelete: Cascade)
  bedNumber String // e.g. B-01, B-02
  status    BedStatus @default(AVAILABLE)
  notes     String?
  updatedAt DateTime  @updatedAt

  admissions Admission[]

  @@unique([wardId, bedNumber])
  @@index([status])
}

model Admission {
  id                String          @id @default(uuid())
  admissionNumber   String          @unique // ADM-2026-0001
  patientId         String
  patient           Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  wardId            String
  ward              Ward            @relation(fields: [wardId], references: [id])
  bedId             String
  bed               Bed             @relation(fields: [bedId], references: [id])
  admittingDoctorId String
  admittingDoctor   Doctor          @relation(fields: [admittingDoctorId], references: [id])
  admissionDate     DateTime        @default(now())
  dischargeDate     DateTime?
  status            AdmissionStatus @default(ADMITTED)
  initialDiagnosis  String
  dischargeSummary  String?
  dailyChargeRate   Decimal         @db.Decimal(10, 2) // LKR
  totalWardCharge   Decimal         @default(0.00) @db.Decimal(10, 2) // LKR
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  invoices Invoice[]

  @@index([patientId])
  @@index([wardId])
  @@index([status])
}

// ---------------------------------------------------------
// Billing & Payments
// ---------------------------------------------------------
model Invoice {
  id             String        @id @default(uuid())
  invoiceNumber  String        @unique // INV-2026-0001
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  admissionId    String?
  admission      Admission?    @relation(fields: [admissionId], references: [id])
  totalAmount    Decimal       @db.Decimal(12, 2) // LKR
  discountAmount Decimal       @default(0.00) @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0.00) @db.Decimal(12, 2)
  netAmount      Decimal       @db.Decimal(12, 2) // totalAmount - discountAmount + taxAmount
  paidAmount     Decimal       @default(0.00) @db.Decimal(12, 2)
  balanceAmount  Decimal       @db.Decimal(12, 2) // netAmount - paidAmount
  status         InvoiceStatus @default(UNPAID)
  issuedByUserId String
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items    InvoiceItem[]
  payments Payment[]

  @@index([invoiceNumber])
  @@index([patientId])
  @@index([status])
  @@index([createdAt])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemType    ItemType
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(12, 2)
  referenceId String? // Optional reference to testId, medicineId, etc.

  @@index([invoiceId])
}

model Payment {
  id               String        @id @default(uuid())
  receiptNumber    String        @unique // REC-2026-0001
  invoiceId        String
  invoice          Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount           Decimal       @db.Decimal(12, 2)
  paymentMethod    PaymentMethod @default(CASH)
  paymentReference String? // Cheque no, Card transaction ref, or bank slip
  notes            String?
  receivedByUserId String
  createdAt        DateTime      @default(now())

  @@index([invoiceId])
  @@index([receiptNumber])
  @@index([createdAt])
}

// ---------------------------------------------------------
// Staff & HR Management
// ---------------------------------------------------------
model Employee {
  id               String         @id @default(uuid())
  employeeNumber   String         @unique // EMP-001
  userId           String?        @unique
  user             User?          @relation(fields: [userId], references: [id])
  fullName         String
  nic              String // Sri Lankan NIC
  designation      String // Senior Staff Nurse, Chief Pharmacist, etc.
  departmentId     String
  department       Department     @relation(fields: [departmentId], references: [id])
  employmentType   EmploymentType @default(PERMANENT)
  joinedDate       DateTime       @db.Date
  salaryLkr        Decimal        @db.Decimal(10, 2)
  phone            String
  email            String?
  emergencyContact String?
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  attendance   Attendance[]
  leaveRecords LeaveRecord[]

  @@index([employeeNumber])
  @@index([nic])
  @@index([departmentId])
}

model Attendance {
  id           String           @id @default(uuid())
  employeeId   String
  employee     Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date         DateTime         @db.Date
  checkInTime  String? // e.g. "07:55 AM"
  checkOutTime String? // e.g. "04:15 PM"
  status       AttendanceStatus @default(PRESENT)
  notes        String?
  createdAt    DateTime         @default(now())

  @@unique([employeeId, date])
  @@index([date])
}

model LeaveRecord {
  id               String      @id @default(uuid())
  employeeId       String
  employee         Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType        LeaveType
  startDate        DateTime    @db.Date
  endDate          DateTime    @db.Date
  totalDays        Int
  reason           String
  status           LeaveStatus @default(PENDING)
  approvedByUserId String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([employeeId])
  @@index([status])
}

// ---------------------------------------------------------
// Audit Logs & Documents & System Settings
// ---------------------------------------------------------
model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  username    String
  userRole    String
  action      String // LOGIN, LOGOUT, CREATE_PATIENT, UPDATE_PRESCRIPTION, DISPENSE_MEDICINE, RECEIVE_PAYMENT, etc.
  entityName  String // Patient, Prescription, Invoice, User, etc.
  entityId    String?
  detailsJson String? // Sanitized details (NO passwords or tokens!)
  ipAddress   String?
  userAgent   String?
  timestamp   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([timestamp])
  @@index([entityName])
}

model PatientDocument {
  id               String   @id @default(uuid())
  patientId        String
  patient          Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  documentName     String
  documentType     String // LAB_REPORT, SCAN_IMAGE, DISCHARGE_SUMMARY, REFERRAL
  fileUrl          String
  fileSize         Int
  mimeType         String
  uploadedByUserId String
  createdAt        DateTime @default(now())

  @@index([patientId])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt

  @@index([key])
}
